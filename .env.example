# Local development API server. Vite remains on port 5173.
APP_API_PORT=3001
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Optional deployment restriction. Leave blank for unrestricted local use.
# For an internet-facing deployment, list the OpenAI-compatible hosts users
# may connect to. Include a port when it is not the protocol default.
# AI_API_ALLOWED_HOSTS=api.openai.com,openrouter.ai

# Proxy limits and upstream timeouts.
MODELS_TIMEOUT_MS=15000
CHAT_TIMEOUT_MS=120000
JSON_BODY_LIMIT=256kb
