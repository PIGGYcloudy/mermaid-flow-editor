{
  "name": "mermaid-flow-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, BYOK Mermaid editor with an OpenAI-compatible AI assistant.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js",
    "test:browser": "npm run build && node scripts/browser-smoke-test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "express": "^4.21.2",
    "html-to-image": "^1.11.11",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  }
}
